{
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/custom-favicon.ico",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/custom-favicon.ico" },
    {
      "source": "/((?!favicon\\.ico|robots\\.txt|sitemap\\.xml|.*\\.(png|jpg|jpeg|gif|svg|webp|ico)).*)",
      "destination": "/"
    }
  ]
}

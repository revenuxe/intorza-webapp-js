{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intorza-webapp-js",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "intorza-webapp-js" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    { "name": "APP_REQUEST_LIMITER", "namespace_id": "2026101401", "simple": { "limit": 120, "period": 60 } },
    { "name": "QUOTATION_AI_LIMITER", "namespace_id": "2026101402", "simple": { "limit": 10, "period": 60 } }
  ]
}

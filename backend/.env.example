# --- Database credentials ---
# Production (recommended): store creds in AWS Secrets Manager and set only
# DB_SECRET_ID here (the secret JSON supplies host/port/dbname/username/password).
# DB_SSL is still read from env. DB_HOST/PORT/NAME may be set as fallbacks.
# DB_SECRET_ID=intorza/rds/app
# AWS_REGION=ap-south-1

# Local dev / fallback: plain connection vars.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=intorza
DB_USER=intorza_app
DB_PASSWORD=change-me
DB_SSL=true

SUPABASE_URL=https://gclsgkhtwqurniitfeir.supabase.co
SUPABASE_JWKS_URL=https://gclsgkhtwqurniitfeir.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# For migrate-data.js only (NOT used at runtime).
# apikey header must be a REAL key (gateway rejects minted tokens as apikey);
# Authorization bearer may be the real service_role key OR a token minted from
# the project JWT secret. If you have the genuine service_role key, set only it
# (it works as both); otherwise set the anon key here + a minted service token.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGIN=http://localhost:8080,https://app.intorza.com
PORT=4000
